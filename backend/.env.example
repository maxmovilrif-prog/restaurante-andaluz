# Copy to .env and adjust for your environment. Never commit the real .env.

# Port the Express API listens on.
PORT=4000

# Set to "production" to make the API also serve the built frontend (frontend/dist)
# from the same origin/process — the simplest deployment for a single small server.
NODE_ENV=development

# Comma-separated list of origins allowed to call the API cross-origin.
# Only needed if the frontend is hosted on a different origin than the API.
# http://localhost:5173 is always allowed in addition to this list.
CORS_ORIGINS=http://restauranteandaluz.es,https://restauranteandaluz.es,https://www.restauranteandaluz.es
