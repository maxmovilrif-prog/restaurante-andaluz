# Copy to .env.production (or .env) and adjust if needed. Never commit the real file.

# Only needed if the frontend is deployed on a DIFFERENT origin than the API
# (e.g. frontend on a CDN, API on a separate host). Leave unset for the default
# same-origin production setup where backend/src/app.js serves this build directly —
# in that case requests to '/api' already resolve correctly with no configuration.
# VITE_API_URL=https://restauranteandaluz.es/api
